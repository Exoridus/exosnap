+void UnlockClonedTree(EbmlElement &element)
+{
+  element.Lock(false);
+  if (auto *master = dynamic_cast<EbmlMaster *>(&element)) {
+    for (auto *child : *master)
+      UnlockClonedTree(*child);
+  }
+}
+
