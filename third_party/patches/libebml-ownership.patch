+  try {
+    auto Itr = ElementToClone.ElementList.begin();
+    auto myItr = ElementList.begin();
+    while (Itr != ElementToClone.ElementList.end())
+    {
+      *myItr = (*Itr)->Clone();
+      ++Itr; ++myItr;
+    }
+  } catch (...) {
+    // Locks on unpublished clones do not transfer ownership to the source.
+    for (auto *element : ElementList) {
+      if (element) {
+        UnlockClonedTree(*element);
+        delete element;
+      }
+    }
+    throw;
   }
+  Lock(ElementToClone.IsLocked());
 
