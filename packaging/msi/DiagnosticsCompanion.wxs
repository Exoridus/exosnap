<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ExoSnap Diagnostics"
           Manufacturer="Codexo"
           Version="$(var.ProductVersion)"
           UpgradeCode="F0CEBFE2-B004-43DC-9063-5960212A1A06"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of ExoSnap Diagnostics is already installed."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="DiagnosticsDirectory" Name="ExoSnap Diagnostics">
        <Component Id="DiagnosticsHelper" Guid="9DA8CB77-5245-479D-9236-A63B7C1BB470">
          <File Id="DiagnosticsExecutable" Source="$(var.DiagnosticsHelper)" KeyPath="yes" />
          <File Id="ExoSnapLicense" Name="LICENSE-ExoSnap.txt" Source="$(var.ExoSnapLicense)" />
          <File Id="PresentMonLicense" Name="LICENSE-PresentMon.txt" Source="$(var.PresentMonLicense)" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="DiagnosticsFeature" Title="ExoSnap Diagnostics">
      <ComponentRef Id="DiagnosticsHelper" />
    </Feature>
  </Package>
</Wix>
