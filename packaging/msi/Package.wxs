<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    ExoSnap MSI Installer
    =====================
    Package identity: Codexo.ExoSnap
    UpgradeCode: 8988DAFC-3AE4-4788-BA6D-62E3F73C7A7D (permanent; do not change between product releases)
    ProductCode is auto-generated per build (*).

    File list is NOT hand-maintained here. `exo-verify package` generates a companion WXS fragment
    (_harvest.wxs) from the pruned CMake install staging tree and passes both
    files to `wix build`. The fragment defines:
      - the subdirectory hierarchy (plugins/, licenses/, …) under INSTALLFOLDER
      - one <Component>/<File> per staged file
      - a master <ComponentGroup Id="StagingFiles"> that this Feature references

    This means the MSI and the portable ZIP are always derived from the same
    source (the cmake install staging tree), so FFmpeg DLLs, dxcompiler.dll,
    dxil.dll, and any future runtime DLL added by a cmake install rule are
    automatically included in both artifacts — no per-file maintenance needed.

    The build script also runs a post-build MSI content assertion (msiexec /a
    extraction) to catch any drift before a release can ship.

    User data is never installed by this MSI and is preserved on uninstall
    unless the caller explicitly sets EXOSNAP_REMOVE_USER_DATA=1.
  -->

  <Package Name="ExoSnap"
           Manufacturer="Codexo"
           Version="$(var.ProductVersion)"
           UpgradeCode="8988DAFC-3AE4-4788-BA6D-62E3F73C7A7D"
           Scope="perMachine"
           Language="1033"
           Codepage="1252">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ExoSnap is already installed."
                  AllowSameVersionUpgrades="yes" />

    <!-- Detects an upgrade from the 0.10.0 product or older. The legacy
         handoff component below needs exactly that transition, not every
         future upgrade. -->
    <Upgrade Id="8988DAFC-3AE4-4788-BA6D-62E3F73C7A7D">
      <UpgradeVersion Minimum="0.0.0"
                      Maximum="0.10.0"
                      IncludeMinimum="yes"
                      IncludeMaximum="yes"
                      OnlyDetect="yes"
                      Property="EXOSNAP_V010_OR_OLDER" />
    </Upgrade>

    <Media Id="1" Cabinet="exosnap.cab" EmbedCab="yes" />

    <!-- The caller property has no default: an ordinary repair or direct
         major upgrade must preserve the existing package-manager owner.
         Resolve before removing the previous product, in both sequences,
         so interactive and silent installs use the same persisted marker. -->
    <Property Id="EXOSNAP_DISTRIBUTION_OWNER" Secure="yes" />
    <Property Id="EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED" Secure="yes">
      <RegistrySearch Id="ExoSnapDistributionOwnerRemembered"
                      Type="raw"
                      Root="HKLM"
                      Key="Software\ExoSnap"
                      Name="DistributionOwner"
                      Bitness="always64" />
    </Property>
    <Property Id="EXOSNAP_DISTRIBUTION_OWNER_PRESENT" Secure="yes" />
    <Property Id="EXOSNAP_DISTRIBUTION_OWNER_STRING" Secure="yes" />
    <Property Id="EXOSNAP_RESOLVED_DISTRIBUTION_OWNER" Secure="yes" />
    <Launch Condition='NOT EXOSNAP_DISTRIBUTION_OWNER OR EXOSNAP_DISTRIBUTION_OWNER = "direct" OR EXOSNAP_DISTRIBUTION_OWNER = "winget" OR EXOSNAP_DISTRIBUTION_OWNER = "chocolatey"'
            Message="EXOSNAP_DISTRIBUTION_OWNER must be direct, winget or chocolatey." />
    <!-- AppSearch skips an empty REG_SZ, so a read-only presence probe must
         distinguish malformed existing markers from genuinely absent ones. -->
    <Binary Id="DistributionOwnerProbe" SourceFile="$(var.DistributionOwnerProbePath)" />
    <CustomAction Id="ProbeDistributionOwner"
                  BinaryRef="DistributionOwnerProbe"
                  DllEntry="ProbeDistributionOwner"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="ResolveDistributionOwnerFromCaller"
                  Property="EXOSNAP_RESOLVED_DISTRIBUTION_OWNER"
                  Value="[EXOSNAP_DISTRIBUTION_OWNER]" />
    <CustomAction Id="ResolveDistributionOwnerFromRegistry"
                  Property="EXOSNAP_RESOLVED_DISTRIBUTION_OWNER"
                  Value="[EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED]" />
    <CustomAction Id="ResolveDistributionOwnerUnknown"
                  Property="EXOSNAP_RESOLVED_DISTRIBUTION_OWNER"
                  Value="unknown" />
    <CustomAction Id="ResolveDistributionOwnerDefault"
                  Property="EXOSNAP_RESOLVED_DISTRIBUTION_OWNER"
                  Value="direct" />
    <InstallUISequence>
      <Custom Action="ProbeDistributionOwner" After="AppSearch" />
      <Custom Action="ResolveDistributionOwnerFromCaller" After="ProbeDistributionOwner" Condition="EXOSNAP_DISTRIBUTION_OWNER" />
      <Custom Action="ResolveDistributionOwnerFromRegistry" After="ResolveDistributionOwnerFromCaller" Condition="NOT EXOSNAP_DISTRIBUTION_OWNER AND EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED AND EXOSNAP_DISTRIBUTION_OWNER_STRING" />
      <Custom Action="ResolveDistributionOwnerUnknown" After="ResolveDistributionOwnerFromRegistry" Condition="NOT EXOSNAP_DISTRIBUTION_OWNER AND EXOSNAP_DISTRIBUTION_OWNER_PRESENT AND (NOT EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED OR NOT EXOSNAP_DISTRIBUTION_OWNER_STRING)" />
      <Custom Action="ResolveDistributionOwnerDefault" After="ResolveDistributionOwnerUnknown" Condition="NOT EXOSNAP_DISTRIBUTION_OWNER AND NOT EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED AND NOT EXOSNAP_DISTRIBUTION_OWNER_PRESENT" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="ProbeDistributionOwner" After="AppSearch" />
      <Custom Action="ResolveDistributionOwnerFromCaller" After="ProbeDistributionOwner" Condition="EXOSNAP_DISTRIBUTION_OWNER" />
      <Custom Action="ResolveDistributionOwnerFromRegistry" After="ResolveDistributionOwnerFromCaller" Condition="NOT EXOSNAP_DISTRIBUTION_OWNER AND EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED AND EXOSNAP_DISTRIBUTION_OWNER_STRING" />
      <Custom Action="ResolveDistributionOwnerUnknown" After="ResolveDistributionOwnerFromRegistry" Condition="NOT EXOSNAP_DISTRIBUTION_OWNER AND EXOSNAP_DISTRIBUTION_OWNER_PRESENT AND (NOT EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED OR NOT EXOSNAP_DISTRIBUTION_OWNER_STRING)" />
      <Custom Action="ResolveDistributionOwnerDefault" After="ResolveDistributionOwnerUnknown" Condition="NOT EXOSNAP_DISTRIBUTION_OWNER AND NOT EXOSNAP_DISTRIBUTION_OWNER_REMEMBERED AND NOT EXOSNAP_DISTRIBUTION_OWNER_PRESENT" />
    </InstallExecuteSequence>

    <!-- Add/Remove Programs uses the product icon, not the executable's. -->
    <Icon Id="ExoSnapAppIcon" SourceFile="$(var.AppIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ExoSnapAppIcon" />

    <!-- A direct `msiexec /i` on a machine without the shared Visual C++
         runtime would succeed and then leave an application that cannot start.
         Refuse before anything is installed. The Windows Installer cannot
         compare version strings in a condition and raw DWORD searches carry a
         `#` prefix that never converts to an integer, so the floor is enforced
         by the installer's own file-version search: `vcruntime140.dll` in
         System32 only satisfies the search at or above the same minimum Burn
         enforces. `Installed` keeps uninstall and maintenance working on
         machines where the runtime is already gone. The Setup bootstrapper and
         the package-manager dependencies satisfy this requirement before this
         package runs. -->
    <Property Id="VCREDISTX64_RUNTIME">
      <DirectorySearch Id="VCRedistX64System64Search" Path="[System64Folder]">
        <!-- vcruntime140.dll carries a 0409 (1033, en-US) version-resource
             translation. A Signature row with a NULL Languages column does not
             match a file that carries a language, so without this the floor
             rejects the very redistributable the Setup installs: the file is
             present at exactly the minimum version and AppSearch still leaves
             the property unset. -->
        <FileSearch Id="VCRuntime140X64Search"
                    Name="vcruntime140.dll"
                    MinVersion="$(var.VCRedistMinVersion)"
                    Languages="1033" />
      </DirectorySearch>
    </Property>
    <Launch Condition="Installed OR VCREDISTX64_RUNTIME"
            Message="ExoSnap requires the Microsoft Visual C++ 2015-2022 x64 Redistributable version $(var.VCRedistMinVersion) or newer. Install it from https://aka.ms/vs/17/release/vc_redist.x64.exe, or use ExoSnap Setup, and run this installer again." />

    <!-- Install-root directory skeleton. The product installs directly under
         Program Files; there is no vendor directory and no repeated ExoSnap
         layer. Subdirectories (plugins/, licenses/, …) come from _harvest.wxs. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ExoSnap" />
    </StandardDirectory>

    <!-- Start Menu shortcut (all-users, per-machine) — stable component GUID across releases -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{C1D2E3F4-A5B6-7890-CDEF-1234567890AB}" KeyPath="yes">
        <Shortcut Id="StartMenuExoSnap"
                  Name="ExoSnap"
                  Description="Windows-native screen, window and region recorder"
                  Target="[INSTALLFOLDER]exosnap.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ExoSnapAppIcon" />
        <RegistryValue Root="HKLM"
                       Key="Software\ExoSnap"
                       Name="installed"
                       Value="1"
                       Type="integer" />
        <RegistryValue Root="HKLM"
                       Key="Software\ExoSnap"
                       Name="InstallPath"
                       Value="[INSTALLFOLDER]"
                       Type="string" />
        <RegistryValue Root="HKLM"
                       Key="Software\ExoSnap"
                       Name="DistributionOwner"
                       Value="[EXOSNAP_RESOLVED_DISTRIBUTION_OWNER]"
                       Type="string" />
        <!-- Clear any stale v0.10.0 product marker under the vendor key. A
             legacy handoff component below rewrites only the two values the
             immutable v0.10.0 updater reads after its handoff; the runtime's
             installed-mode detection also accepts the legacy key as a fallback
             while an old version is still present. -->
        <RemoveRegistryKey Root="HKLM" Key="Software\Codexo\ExoSnap" Action="removeOnInstall" />
      </Component>
    </StandardDirectory>

    <!-- The immutable v0.10.0 updater re-reads InstallPath from the legacy
         product key after its MSI handoff and relaunches that directory. A
         v0.10.0 -> 0.10.1 upgrade moves the product, so the old updater can
         only complete its verify/relaunch if the legacy key names the new
         location. This component writes that handoff once, for upgrades from
         0.10.0 or older, after the stale key was cleared above; the v0.10.1
         runtime always prefers HKLM\Software\ExoSnap. The values are removed
         when the product is uninstalled. -->
    <Component Id="LegacyHandoff"
               Guid="{EA1AE131-D32E-422C-A610-3BFB1C4E642A}"
               Directory="INSTALLFOLDER"
               Condition="EXOSNAP_V010_OR_OLDER">
      <RegistryValue Root="HKLM"
                     Key="Software\Codexo\ExoSnap"
                     Name="installed"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="Software\Codexo\ExoSnap"
                     Name="InstallPath"
                     Value="[INSTALLFOLDER]"
                     Type="string" />
    </Component>

    <!-- Optional desktop shortcut. The offline Setup renders an unchecked
         "Create a desktop shortcut" option; the raw MSI and every package
         manager leave it absent. `DesktopShortcut` under the product key
         remembers a chosen shortcut across a major upgrade, where the old
         product is removed before the new product is costed. -->
    <Property Id="EXOSNAP_DESKTOP_SHORTCUT" Value="0" Secure="yes" />
    <Property Id="EXOSNAP_DESKTOP_SHORTCUT_REMEMBERED">
      <RegistrySearch Id="ExoSnapDesktopShortcutRemembered"
                      Type="raw"
                      Root="HKLM"
                      Key="Software\ExoSnap"
                      Name="DesktopShortcut"
                      Bitness="always64" />
    </Property>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut"
                 Guid="{9BEDB693-BF11-4589-B5A4-AD17A96F1F7E}"
                 Condition='EXOSNAP_DESKTOP_SHORTCUT = 1 OR EXOSNAP_DESKTOP_SHORTCUT_REMEMBERED = "#1"'>
        <Shortcut Id="DesktopExoSnap"
                  Name="ExoSnap"
                  Description="Windows-native screen, window and region recorder"
                  Target="[INSTALLFOLDER]exosnap.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ExoSnapAppIcon" />
        <RegistryValue Root="HKLM"
                       Key="Software\ExoSnap"
                       Name="DesktopShortcut"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Optional local-data removal on uninstall. The offline Setup renders an
         unchecked option and is the only caller that passes the flag; the raw
         MSI and every package manager preserve user data unless an
         administrator explicitly sets EXOSNAP_REMOVE_USER_DATA=1.

         The elevated MSI must never delete a caller-supplied path. The
         property setter below overwrites EXOSNAP_USER_DATA_DIR with the fixed
         %LOCALAPPDATA%\ExoSnap template before RemoveFolderEx reads it, so a
         command-line override can never redirect the removal. The directory is
         removed only while this component is being uninstalled, which keeps
         install, repair and major upgrades non-destructive. Recordings live
         under the Videos known folder and are never this target. -->
    <Property Id="EXOSNAP_REMOVE_USER_DATA" Value="0" Secure="yes" />
    <Property Id="EXOSNAP_USER_DATA_DIR" Secure="yes" />
    <CustomAction Id="SetExoSnapUserDataDir"
                  Property="EXOSNAP_USER_DATA_DIR"
                  Value="%LOCALAPPDATA%\ExoSnap" />
    <InstallExecuteSequence>
      <Custom Action="SetExoSnapUserDataDir" Before="CostInitialize" Condition="EXOSNAP_REMOVE_USER_DATA = 1" />
    </InstallExecuteSequence>
    <Component Id="ExoSnapUserDataCleanup"
               Guid="{E8E337A2-AAEA-43AE-AC1F-9FB82D6377B5}"
               Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM"
                     Key="Software\ExoSnap"
                     Name="UserDataCleanup"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
      <util:RemoveFolderEx Id="ExoSnapUserDataFolder"
                           On="uninstall"
                           Property="EXOSNAP_USER_DATA_DIR"
                           Condition="EXOSNAP_REMOVE_USER_DATA = 1" />
    </Component>

    <!-- ARP (Add/Remove Programs) metadata.
         The description matches docs/product-spec.md and the other package
         manifests word for word: an installed-apps entry that describes the
         product differently from the package manager it came from reads as a
         different product. -->
    <Property Id="ARPCOMMENTS" Value="Windows-native screen, window and region recorder with an NVIDIA NVENC pipeline, multi-track audio, and diagnostics." />
    <Property Id="ARPCONTACT" Value="https://github.com/Exoridus/exosnap" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Exoridus/exosnap" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Exoridus/exosnap/issues" />
    <Property Id="ARPREADME" Value="https://github.com/Exoridus/exosnap#readme" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Exoridus/exosnap/releases" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="0" />

    <!-- InstallLocation is not derived from INSTALLFOLDER by Windows Installer; it
         is written only from this property, and only a value resolved after
         CostFinalize is the directory the user actually chose. Package managers and
         inventory tools read it as the standard answer to "where did this install",
         which is why it matters even though the product finds itself through
         HKLM\Software\ExoSnap\InstallPath. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />

    <!-- Feature tree.
         StagingFiles is the master ComponentGroup defined in _harvest.wxs;
         it aggregates every file in the pruned cmake staging tree. -->
    <Feature Id="MainFeature"
             Title="ExoSnap"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER"
             Display="expand"
             Description="ExoSnap recording application">
      <ComponentGroupRef Id="StagingFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="LegacyHandoff" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="ExoSnapUserDataCleanup" />
    </Feature>

  </Package>
</Wix>
