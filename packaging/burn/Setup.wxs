<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- The private UI payload is available before the chain installs the shared VC runtime. -->

  <Bundle Name="ExoSnap"
          Version="$(var.BundleVersion)"
          Manufacturer="Codexo"
          UpgradeCode="{15DD5AFF-4C08-4549-BB4E-ECBF10913E77}"
          DisableModify="yes"
          DisableRemove="yes"
          IconSourceFile="$(var.IconPath)"
          AboutUrl="https://github.com/Exoridus/exosnap"
          HelpUrl="https://github.com/Exoridus/exosnap/issues"
          Copyright="Copyright 2026 Codexo">

    <!-- Test the same binary as the MSI launch condition so stale runtime
         registration alone cannot skip prerequisite installation. -->
    <Variable Name="VCRedistVersion" Type="version" Value="0.0.0.0" />
    <Variable Name="VCRedistFloor" Type="version" Value="$(var.VCRedistMinVersion)" />
    <util:FileSearch Id="VCRedistVersionSearch"
                     Variable="VCRedistVersion"
                     Path="[System64Folder]vcruntime140.dll"
                     Result="version" />

    <!-- The selected MSI owns the optional desktop shortcut. -->
    <Variable Name="ExoSnapDesktopShortcut" Type="numeric" Value="0" />
    <Variable Name="ExoSnapAllUsers" Type="numeric" Value="0" />

    <BootstrapperApplication>
      <BootstrapperApplicationDll Id="ExoSnapNativeBA" SourceFile="$(var.BootstrapperPath)" />
      <PayloadGroupRef Id="ExoSnapSetupUiPayloads" />
    </BootstrapperApplication>

    <Chain>
      <ExePackage Id="VCRedistX64"
                  SourceFile="$(var.VCRedistPath)"
                  Compressed="yes"
                  Vital="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  InstallArguments="/install /quiet /norestart"
                  DetectCondition="VCRedistVersion &gt;= $(var.VCRedistMinVersion)">
        <!-- A newer runtime already present is success, not failure. -->
        <ExitCode Value="1638" Behavior="success" />
        <!-- Success with a pending restart is reported as such; Burn offers
             the restart instead of silently rebooting. -->
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <MsiPackage Id="ExoSnapMsi"
                  SourceFile="$(var.MsiPath)"
                  Compressed="yes"
                  Vital="yes"
                  InstallCondition="ExoSnapAllUsers = 1"
                  Visible="yes">
        <MsiProperty Name="EXOSNAP_SETUP_MAINTENANCE" Value="1" />
        <MsiProperty Name="EXOSNAP_DESKTOP_SHORTCUT" Value="[ExoSnapDesktopShortcut]" />
      </MsiPackage>

      <!-- Burn 4 fixes the bundle registry scope at build time. Let the selected
           MSI own the visible Installed Apps entry in its own registration scope. -->
      <MsiPackage Id="ExoSnapUserMsi"
                  SourceFile="$(var.UserMsiPath)"
                  Compressed="yes"
                  Vital="yes"
                  InstallCondition="ExoSnapAllUsers = 0"
                  Visible="yes">
        <MsiProperty Name="EXOSNAP_DESKTOP_SHORTCUT" Value="[ExoSnapDesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
