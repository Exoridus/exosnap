<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ExoSnap.Verify.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The only reader that survives WDA_EXCLUDEFROMCAPTURE: UI Automation through
         a typed client, so a visual gate asserts on elements rather than on a
         screenshot it cannot take. -->
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

</Project>
