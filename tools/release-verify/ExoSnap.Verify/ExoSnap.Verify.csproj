<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ExoSnap.Verify</RootNamespace>
    <AssemblyName>ExoSnap.Verify</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The release PC is not required to carry a matching .NET runtime. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExoSnap.Verify.Windows\ExoSnap.Verify.Windows.csproj" />
  </ItemGroup>

  <!-- The packet-span parser is internal; the adapter contract tests exercise it
       directly against a committed CSV fixture rather than spawning ffprobe. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ExoSnap.Verify.Tests" />
  </ItemGroup>

</Project>
